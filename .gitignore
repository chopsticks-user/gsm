# Build output: everything goes to build/ (go build -o build/ ./cmd/gsm,
# scripts/release-build.sh); /gsm covers a plain go build at the root.
/build/
/gsm
/gsm.exe

# Go: test binaries, profiles and coverage (anywhere in the tree)
*.test
*.prof
*.out
*.coverprofile

# Dev shell state (GOPATH, module and build caches)
/.go/

# Nix and direnv (result links appear wherever nix build runs)
result
result-*
/.direnv/

# taskie worktrees, one per issue
/.worktrees/

# Claude Code per-user files (the shared .claude/CLAUDE.md is tracked)
.claude/settings.local.json
CLAUDE.local.md

# Editors (shared VS Code settings and extension recommendations may be committed)
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini
